# One server-side key shared by character conversations. Never expose it in client code.
OPENROUTER_API_KEY=

# Server-side FLUX avatar generation through AI/ML API.
AIML_API_KEY=

# Optional direct Black Forest Labs fallback.
BFL_API_KEY=

# Comma-separated accounts allowed to use WebMCP write operations.
WEBMCP_ADMIN_EMAILS=your-email@example.com

# Optional local-only identity used for WebMCP preview testing.
WEBMCP_PREVIEW_EMAIL=
